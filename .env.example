# Copie para .env.local para testar com `vercel dev`, ou cole cada uma
# dessas variáveis no painel da Vercel → Project Settings → Environment
# Variables. NUNCA commite um arquivo .env com valores reais.

# --- SMTP do domínio TRUEHOPE (envio do e-mail de confirmação) ------------
SMTP_HOST=smtp.seudominio.com.br
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=contato@truehope.com.br
SMTP_PASS=
SMTP_FROM="TRUEHOPE <contato@truehope.com.br>"

# --- Google Sheets (guarda os leads) ---------------------------------------
# Crie uma Service Account no Google Cloud, ative a Google Sheets API,
# compartilhe a planilha com o e-mail da service account (permissão de editor)
# e cole o ID da planilha (o trecho entre /d/ e /edit na URL).
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEET_ID=

# --- links e cupom do e-mail -------------------------------------------------
SITE_URL=https://truehope-masterclass.vercel.app
CUPOM_CODE=TRUEHOPE15
LINK_COLECAO=
LINK_COMUNIDADE=
LINK_DESCADASTRO=
